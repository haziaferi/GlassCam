    <color name="nextgen_settings_outline">#33FFFFFF</color>     <!-- hairline panel edge (~20% white) -->
    <color name="nextgen_settings_sticky">#E6121212</color>      <!-- pinned section label over the list -->
    <color name="nextgen_settings_ripple">#4064DD17</color>      <!-- accent-tinted press ripple -->
    <color name="nextgen_switch_thumb_off">#B0B0B0</color>       <!-- neutral switch thumb when off -->
