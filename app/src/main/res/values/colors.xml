    <color name="button_clicked">#8064DD17</color>


    <color name="nextgen_menu_right_text">#FFFFFFFF</color>
    <color name="manual_button_active">#64DD17</color>

    <!-- NextGen Settings panel design tokens.
         Grounded in Material 3 role semantics (onSurface / onSurfaceVariant / outlineVariant)
         but kept translucent so the live camera preview stays visible behind the panel.
         The accent reuses the app's existing "active control" lime (manual_button_active),
         so the Settings screen reads as the same app as the manual-control strip beside it. -->
    <color name="nextgen_menu_secondary_text">#99FFFFFF</color>   <!-- supporting/description + unselected tab (~60% white) -->
    <color name="nextgen_setting_value">#64DD17</color>          <!-- current value = "active", matches manual_button_active -->
