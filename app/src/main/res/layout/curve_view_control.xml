<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_drag"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:background="@drawable/roundcorners"
            android:textColor="@color/nextgen_menu_right_text"
            android:layout_weight="1"
            android:text="@string/curve_drag" />

        <Button
            android:id="@+id/button_save"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@drawable/roundcorners"
            android:text="@string/curve_save"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_load"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@drawable/roundcorners"
            android:text="@string/curve_load"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_add_point"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@drawable/roundcorners"
            android:text="@string/symbol_plus"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_remove_point"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@drawable/roundcorners"
            android:text="@string/symbol_minus"
            android:textColor="@color/nextgen_menu_right_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_rgb"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@android:color/background_light"
            android:text="@string/curve_channel_rgb"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_red"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@android:color/holo_red_dark"
            android:text="@string/curve_channel_r"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_green"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@android:color/holo_green_dark"
            android:text="@string/curve_channel_g"
            android:textColor="@color/nextgen_menu_right_text" />

        <Button
            android:id="@+id/button_blue"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/curveViewButtonHeight"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_dark"
            android:text="@string/curve_channel_b"
            android:textColor="@color/nextgen_menu_right_text" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <view
            android:id="@+id/curveViewHolder"
            class="glasscam.views.CurveView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/uiSettingsBackground" />

        <LinearLayout
            android:id="@+id/save_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/roundcorners"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/curve_name_prompt" />

            <EditText
                android:id="@+id/editText_curvename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="textPersonName"
                android:text="@string/curve_name_hint" />

            <Button
                android:id="@+id/button_savecurve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/curve_save_named" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/load_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/roundcorners"
                android:isScrollContainer="true"
                android:orientation="vertical" />
        </ScrollView>
    </RelativeLayout>


</LinearLayout>