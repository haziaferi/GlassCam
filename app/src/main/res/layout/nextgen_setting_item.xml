<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="glasscam.settings.ValueLabels" />
        <variable
            name="parameter"
            type="glasscam.cam.apis.basecamera.parameters.AbstractParameter" />
    </data>

    <RelativeLayout
        android:id="@+id/relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nextgen_settings_row_min_height"
        android:paddingStart="@dimen/settings_row_padding_horizontal"
        android:paddingEnd="@dimen/settings_row_padding_horizontal"
        android:paddingTop="@dimen/settings_row_padding_vertical"
        android:paddingBottom="@dimen/settings_row_padding_vertical"
        setViewState="@{parameter.viewState}">

        <!-- Label takes the leftover width (weight=1); the value sizes to its content and sits at
             the right. This replaces the old fixed maxWidth="120dp" cap, which was density px and
             did not grow with the system font-scale, so a long value like "5184x3888" ellipsized
             to "5184x..." at large font sizes. The value now wraps to two lines before it
             ellipsizes, and an empty value (button-type rows reuse this layout) takes no text width (its 8dp start margin remains)
             so the label keeps the whole row. -->
        <LinearLayout
            android:id="@+id/row_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Label: primary emphasis (M3 titleMedium role) - full white, bold, 16sp. -->
            <TextView
                android:id="@+id/textView_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/nextgen_menu_right_text"
                android:textSize="@dimen/settings_menu_item_header"
                android:textStyle="bold" />

            <!-- Current value: accent lime, so the live selection reads as "active" and matches
                 the manual-control strip beside the panel. Right-aligned, up to two lines. -->
            <TextView
                android:id="@+id/textView_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@{ValueLabels.label(context, parameter.key, parameter.stringValue)}"
                android:textColor="@color/nextgen_setting_value"
                android:textSize="@dimen/settings_menu_item_header_value" />

        </LinearLayout>

        <!-- Supporting description: secondary emphasis (M3 bodySmall / onSurfaceVariant) - 12sp,
             ~60% white so it recedes below the label instead of competing with it. -->
        <TextView
            android:id="@+id/textView_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/row_holder"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/nextgen_menu_secondary_text"
            android:textSize="@dimen/settings_menu_item_description" />

    </RelativeLayout>
</layout>
