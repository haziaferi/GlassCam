<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="parameter"
            type="glasscam.cam.apis.basecamera.parameters.AbstractParameter" />
    </data>

    <!-- One shutter-column cell: glyph on top, short caption under it. Batch 2 (2026-09-16):
         the whole cell is the tap target (minHeight 48dp, the click listener sits on the holder,
         not on the glyph alone), and the caption no longer marquees - it is a single line that
         ellipsizes, fed a short form of the value by NextGenCameraUiTextSwitch.shortCaption(). -->
    <LinearLayout
        android:id="@+id/layout_holder"
        setViewState="@{parameter.viewState}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_value_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/nextgen_menu_right_text"
            android:shadowColor="@color/black_overlay"
            android:shadowRadius="3"
            app:fontFamily="@font/glasscam" />

        <TextView
            android:id="@+id/textView_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nextgen_menu_right_text"
            android:shadowColor="@color/black_overlay"
            android:shadowRadius="3" />

    </LinearLayout>
</layout>
